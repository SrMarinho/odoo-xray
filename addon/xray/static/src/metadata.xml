<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="xray.Field" t-inherit="web.Field" t-inherit-mode="extension">
        <xpath expr="//div[@t-att-name='props.name']" position="attributes">
            <attribute name="t-att">xrayMetadata</attribute>
        </xpath>
    </t>
    <t t-name="xray.FormLabel" t-inherit="web.FormLabel" t-inherit-mode="extension">
        <xpath expr="//label" position="attributes">
            <attribute name="t-att">xrayMetadata</attribute>
        </xpath>
    </t>
    <t t-name="xray.ListRenderer.RecordRow" t-inherit="web.ListRenderer.RecordRow" t-inherit-mode="extension">
        <xpath expr="//td[@t-att-name='column.name']" position="attributes">
            <attribute name="t-att">xrayCellMetadata(record, column)</attribute>
        </xpath>
    </t>
</templates>
