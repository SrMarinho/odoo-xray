{
  "manifest_version": 3,
  "name": "Odoo X-Ray",
  "version": "0.3.0",
  "description": "Inspecione campos e elementos de views do Odoo e abra sua origem no VS Code.",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:17654/*"],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "odoo-xray@srmarinho",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/odoo/*", "http://*/web*", "https://*/odoo/*", "https://*/web*"],
      "js": ["src/rpc.js", "src/extract.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "icons": {}
}
