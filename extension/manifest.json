{
  "manifest_version": 3,
  "name": "Odoo X-Ray",
  "version": "0.1.0",
  "description": "Hover num campo do Odoo, veja o modelo/campo/módulo, abra o arquivo:linha no VSCode.",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:17654/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/odoo/*", "http://*/web*", "https://*/odoo/*", "https://*/web*"],
      "js": ["src/rpc.js", "src/extract.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "icons": {}
}
